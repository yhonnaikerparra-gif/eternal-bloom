# ==========================================
# ETERNAL BLOOM — Configuración del Sistema
# ==========================================

# Servidor
PORT=3001
NODE_ENV=production

# Programación Horaria Diaria (5:00 a. m. hora de Colombia)
TIMEZONE=America/Bogota
CRON_SCHEDULE="0 5 * * *"

# Seguridad y Autenticación del Panel de Control
ADMIN_PASSWORD=amor-eterno-2026
JWT_SECRET=coloca-aqui-un-secreto-aleatorio-seguro-jwt

# ------------------------------------------
# INTEGRACIÓN 1: Gmail (Recomendado)
# ------------------------------------------
# Genera una contraseña de aplicación en https://myaccount.google.com/apppasswords
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_SENDER_NAME="ETERNAL BLOOM"

# ------------------------------------------
# INTEGRACIÓN 2: WhatsApp Business Cloud API (Meta)
# ------------------------------------------
# Obtenido en https://developers.facebook.com
WHATSAPP_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_WEBHOOK_VERIFY_TOKEN=eternal-bloom-verify-token-2026

# ------------------------------------------
# GENERACIÓN DE CARTAS: Google Gemini API (Opcional)
# ------------------------------------------
# Si no se configura, el sistema utiliza la biblioteca local de más de 100 cartas originales
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
